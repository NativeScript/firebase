<Page xmlns="http://schemas.nativescript.org/tns.xsd" navigatingTo="navigatingTo" class="page">
    <Page.actionBar>
        <ActionBar title="firebase-ai" icon="" class="action-bar">
        </ActionBar>
    </Page.actionBar>
    <StackLayout class="p-20">
        <ScrollView class="h-full">
          <StackLayout>
            <Button text="Generate content" tap="{{ testIt }}" class="btn btn-primary"/>
            <Button text="Stream content" tap="{{ testStream }}" class="btn btn-primary"/>
            <Button text="Chat" tap="{{ testChat }}" class="btn btn-primary"/>
          </StackLayout>
        </ScrollView>
    </StackLayout>
</Page>
